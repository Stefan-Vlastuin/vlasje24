# Kopieer dit bestand naar .env en vul de waarden in.
# .env wordt NOOIT gecommit (staat in .gitignore).

# MySQL root-wachtwoord (alleen voor interne DB-initialisatie)
MYSQL_ROOT_PASSWORD=

# Wachtwoord voor de applicatie-gebruiker (vlasje24_app)
MYSQL_APP_PASSWORD=

# Alleen eenmalig op true zetten bij de eerste Flyway-deploy op een bestaande database
FLYWAY_BASELINE_ON_MIGRATE=false

# Sessieduur als Spring Duration (bijvoorbeeld 14d of 12h)
SESSION_TIMEOUT=14d

# In productie altijd true; de lokale Docker override zet dit op false voor HTTP
SESSION_COOKIE_SECURE=true

# Expliciete, kommagescheiden frontend-origins die credentialed CORS mogen gebruiken
CORS_ALLOWED_ORIGINS=https://jouwdomein.nl

# Domeinnaam voor productie (zonder https://)
DOMAIN=jouwdomein.nl

# Docker Hub gebruikersnaam (voor bouwen en pushen van images)
DOCKER_USERNAME=jouw-dockerhub-naam
